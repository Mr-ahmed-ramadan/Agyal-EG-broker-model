# --- API ---------------------------------------------------------------------
PORT=3000
DATABASE_URL=postgresql://agyal:agyal@localhost:5432/agyal_broker?schema=public

# Resolve tenant from Host header; for local dev, fall back to this tenant slug.
DEV_DEFAULT_TENANT=demo-broker

# JWT signing secret (replace with a managed secret in any shared environment)
JWT_SECRET=change-me

# HMAC key for one-time SMS codes (required in production)
OTP_SECRET=change-me
# Local development only: return the SMS code in the API response so you can
# sign in without an SMS gateway. Ignored when NODE_ENV=production.
OTP_DEV_ECHO=true

# Master key reference for per-tenant envelope encryption (ADR 0002).
# Local dev only: a 32-byte base64 key. Production: a KMS key ID.
KMS_MASTER_KEY_LOCAL=

# One-time codes: "log" (development: printed in the API log) or "resend"
# (email via Resend; required in production until an SMS gateway is chosen).
OTP_DELIVERY=log
RESEND_API_KEY=
EMAIL_FROM=
# Allowed browser origins (comma-separated); required in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Demo/testing only: confirm coupons and redemptions before their payment date.
DEMO_MODE=false
# Seed: first platform admin, and whether to create demo broker staff.
ADMIN_EMAIL=admin@agyal.local
ADMIN_MOBILE=01000000000
ADMIN_PASSWORD=
SEED_DEMO_STAFF=true

# --- Vendors (mocks by default) ----------------------------------------------
EKYC_PROVIDER=mock
AML_PROVIDER=mock
MCDR_ADAPTER=manual

# --- FIX gateway ---------------------------------------------------------------
# The gateway reads its own QuickFIX/J session config; see services/fix-gateway.
FIX_GATEWAY_CONFIG=src/main/resources/initiator.cfg

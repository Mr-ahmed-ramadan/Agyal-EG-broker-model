# --- API ---------------------------------------------------------------------
PORT=3000
DATABASE_URL=postgresql://agyal:agyal@localhost:5432/agyal_broker?schema=public

# Resolve tenant from Host header; for local dev, fall back to this tenant slug.
DEV_DEFAULT_TENANT=demo-broker

# JWT signing secret (replace with a managed secret in any shared environment)
JWT_SECRET=change-me

# Master key reference for per-tenant envelope encryption (ADR 0002).
# Local dev only: a 32-byte base64 key. Production: a KMS key ID.
KMS_MASTER_KEY_LOCAL=

# --- Vendors (mocks by default) ----------------------------------------------
EKYC_PROVIDER=mock
AML_PROVIDER=mock
MCDR_ADAPTER=manual

# --- FIX gateway ---------------------------------------------------------------
# The gateway reads its own QuickFIX/J session config; see services/fix-gateway.
FIX_GATEWAY_CONFIG=src/main/resources/initiator.cfg

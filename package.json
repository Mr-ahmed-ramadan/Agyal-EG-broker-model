{
  "name": "agyal-broker-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Agyal Broker Platform - white-label, FIX-native fixed-income SaaS for Egyptian brokers",
  "workspaces": [
    "packages/*",
    "services/api",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "dev:api": "npm run dev --workspace services/api",
    "dev:client-web": "npm run dev --workspace apps/client-web",
    "dev:broker-console": "npm run dev --workspace apps/broker-console",
    "dev:admin-console": "npm run dev --workspace apps/admin-console",
    "dev:bank-portal": "npm run dev --workspace apps/bank-portal"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}

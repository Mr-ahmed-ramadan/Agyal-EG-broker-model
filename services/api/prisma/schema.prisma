// Agyal Broker Platform data model.
//
// Every model with a non-null `tenantId` is protected by PostgreSQL Row-Level
// Security (see the RLS section of the init migration and ADR 0002). The API
// only touches those tables through `DbService.forTenant()`, which sets
// `app.tenant_id` for the transaction. Platform-level models (Tenant, Bank,
// Instrument, FIX outbox/inbox/message store) are not tenant-scoped.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy (ADR 0002)
// ---------------------------------------------------------------------------

model Tenant {
  id           String       @id @default(uuid())
  slug         String       @unique
  legalNameEn  String
  legalNameAr  String
  fraLicenseNo String?
  status       TenantStatus @default(ACTIVE)
  /// BROKER (a customer) or PROSPECT_DEMO (a branded demo for a prospect)
  kind         String       @default("BROKER")
  customDomain String?      @unique
  /// TenantBranding from @agyal/shared-types
  branding     Json
  /// TenantConfig: pricing, auto-approval rules, enabled instruments
  config       Json
  createdAt    DateTime     @default(now())

  users         User[]
  bankRelations BrokerBankRelationship[]
}

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

/// A prospect broker who contacted Agyal from the landing page (platform-level).
model Lead {
  id        String    @id @default(uuid())
  name      String
  firm      String
  role      String?
  email     String
  mobile    String?
  message   String?
  ip        String?
  emailedAt DateTime?
  error     String?
  createdAt DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  /// null for Agyal platform operators
  tenantId     String?
  email            String
  mobile           String?
  /// Set when the user first proves possession of the mobile with an OTP
  mobileVerifiedAt DateTime?
  passwordHash     String
  roles            String[]
  createdAt        DateTime  @default(now())

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  otpChallenges OtpChallenge[]

  @@unique([tenantId, email])
}

/// One-time code sent by SMS (login second factor, mobile verification).
model OtpChallenge {
  id         String    @id @default(uuid())
  userId     String
  /// LOGIN, VERIFY_MOBILE or STEP_UP
  purpose    String
  /// STEP_UP only: the action the code authorises, run when it is verified
  payload    Json?
  /// HMAC of the code; the code itself is never stored
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Clients & onboarding (ADR 0005)
// ---------------------------------------------------------------------------

model Client {
  id                  String       @id @default(uuid())
  tenantId            String
  userId              String       @unique
  /// Reference the client quotes on transfers into the broker's client-money account
  depositReference    String
  status              ClientStatus @default(ONBOARDING)
  fullNameEn          String?
  fullNameAr          String?
  nationalIdEncrypted String?
  nationalIdLast4     String?
  dateOfBirth         DateTime?
  riskRating          RiskRating?
  riskProfile         RiskProfile?
  kycApprovedAt       DateTime?
  kycReviewDueAt      DateTime?
  createdAt           DateTime     @default(now())

  onboarding      OnboardingApplication?
  investorCode    InvestorCode?
  custodyAccounts CustodyAccount[]
  consents        Consent[]
  orders          Order[]
  bankAccounts    ClientBankAccount[]
  withdrawals     Withdrawal[]
  incomes         IncomeEntitlement[]

  @@unique([tenantId, depositReference])
  @@index([tenantId, status])
}

enum ClientStatus {
  ONBOARDING
  PENDING_APPROVAL
  NEEDS_INFO
  ACTIVE
  REJECTED
  SUSPENDED
}

enum RiskRating {
  LOW
  MEDIUM
  HIGH
}

enum RiskProfile {
  CONSERVATIVE
  BALANCED
  GROWTH
}

model OnboardingApplication {
  id           String    @id @default(uuid())
  tenantId     String
  clientId     String    @unique
  /// Steps completed so far, e.g. ["IDENTITY","PROFILE"]
  completed    String[]
  ekycResult   Json?
  profile      Json?
  amlResult    Json?
  suitability  Json?
  submittedAt  DateTime?
  /// Auto-approval rule version, or the broker user who decided
  decisionBy   String?
  decisionNote String?
  decidedAt    DateTime?
  updatedAt    DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id])
}

model Consent {
  id           String   @id @default(uuid())
  tenantId     String
  clientId     String
  type         String
  version      String
  ip           String?
  acceptedAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

/// The client's own bank account for withdrawals (ADR 0007).
model ClientBankAccount {
  id         String   @id @default(uuid())
  tenantId   String
  clientId   String
  iban       String
  bankName   String
  holderName String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  client      Client       @relation(fields: [clientId], references: [id])
  withdrawals Withdrawal[]

  @@index([clientId])
}

/// Client withdrawal to their own bank account, with maker-checker payout (ADR 0007).
model Withdrawal {
  id            String   @id @default(uuid())
  tenantId      String
  clientId      String
  bankAccountId String
  amount        Decimal  @db.Decimal(20, 2)
  /// REQUESTED, APPROVED, PAID or REJECTED
  status        String   @default("REQUESTED")
  requestedAt   DateTime @default(now())
  approvedById  String?
  approvedAt    DateTime?
  paidById      String?
  paidAt        DateTime?
  bankReference String?
  rejectReason  String?

  client      Client            @relation(fields: [clientId], references: [id])
  bankAccount ClientBankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([tenantId, status])
}

/// A coupon or redemption received from the issuer and paid to clients (ADR 0007).
model IncomeEvent {
  id          String   @id @default(uuid())
  tenantId    String
  isin        String
  /// COUPON or REDEMPTION
  type        String
  paymentDate DateTime
  /// Cash per 100 of face value
  per100      Decimal  @db.Decimal(18, 8)
  totalGross  Decimal  @db.Decimal(20, 2)
  totalTax    Decimal  @db.Decimal(20, 2)
  /// Custodian / CBE payment reference
  reference   String
  confirmedById String
  confirmedAt DateTime @default(now())

  entitlements IncomeEntitlement[]

  @@unique([tenantId, isin, type, paymentDate])
}

model IncomeEntitlement {
  id       String  @id @default(uuid())
  tenantId String
  eventId  String
  clientId String
  nominal  Decimal @db.Decimal(20, 2)
  gross    Decimal @db.Decimal(20, 2)
  tax      Decimal @db.Decimal(20, 2)
  net      Decimal @db.Decimal(20, 2)

  event  IncomeEvent @relation(fields: [eventId], references: [id])
  client Client      @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// MCDR unified code & custody (ADR 0006)
// ---------------------------------------------------------------------------

model InvestorCode {
  id        String             @id @default(uuid())
  tenantId  String
  clientId  String             @unique
  code      String?
  status    InvestorCodeStatus @default(NOT_REQUESTED)
  /// EXISTING_DECLARED or NEW_REQUEST
  source    String?
  updatedAt DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id])
}

enum InvestorCodeStatus {
  NOT_REQUESTED
  EXISTING_DECLARED
  REQUESTED
  VERIFIED
  REJECTED
}

model CustodyAccount {
  id            String     @id @default(uuid())
  tenantId      String
  clientId      String
  custodian     String
  accountNumber String
  depository    Depository
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, depository])
}

enum Depository {
  MCDR
  CBE
  BANK_INTERNAL
}

// ---------------------------------------------------------------------------
// Banks & instruments (platform-level) (ADR 0004)
// ---------------------------------------------------------------------------

model Bank {
  id             String             @id @default(uuid())
  code           String             @unique
  nameEn         String
  nameAr         String
  connectionMode BankConnectionMode
  /// Our SenderCompID and the bank's TargetCompID for FIX-mode banks
  fixSenderCompId String?
  fixTargetCompId String?
  active         Boolean            @default(true)

  relations BrokerBankRelationship[]
}

enum BankConnectionMode {
  FIX
  PORTAL
  FILE
}

model BrokerBankRelationship {
  id                  String  @id @default(uuid())
  tenantId            String
  bankId              String
  brokerAccountAtBank String
  active              Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  bank   Bank   @relation(fields: [bankId], references: [id])

  @@unique([tenantId, bankId])
}

model Instrument {
  id           String         @id @default(uuid())
  isin         String         @unique
  type         InstrumentType
  issuer       String
  nameEn       String
  nameAr       String
  currency     String         @default("EGP")
  /// Annual coupon rate as a fraction (0.25 = 25%); null for T-bills
  couponRate   Decimal?       @db.Decimal(9, 6)
  /// Coupons per year; null for T-bills
  couponFreq   Int?
  issueDate    DateTime?
  maturityDate DateTime
  depository   Depository
  /// Minimum and increment of nominal (face value) per order
  minQty       Decimal        @db.Decimal(20, 2)
  qtyIncrement Decimal        @db.Decimal(20, 2)
}

enum InstrumentType {
  TREASURY_BOND
  TREASURY_BILL
  CORPORATE_BOND
  SUKUK
}

// ---------------------------------------------------------------------------
// FIX-native order model (ADR 0003)
// ---------------------------------------------------------------------------

model QuoteRequest {
  id         String   @id @default(uuid())
  tenantId   String
  /// QuoteReqID(131)
  quoteReqId String   @unique
  clientId   String
  isin       String
  /// Side(54)
  side       String
  orderQty   Decimal  @db.Decimal(20, 2)
  settlDate  DateTime
  createdAt  DateTime @default(now())

  quotes Quote[]
}

model Quote {
  id             String   @id @default(uuid())
  tenantId       String
  quoteRequestId String
  bankId         String
  /// QuoteID(117), from the bank
  quoteId        String
  /// PriceType(423)
  priceType      String
  /// Clean prices, % of par: OfferPx(133) answers a buy RFQ, BidPx(132) a sell RFQ
  offerPx        Decimal? @db.Decimal(18, 8)
  offerYield     Decimal? @db.Decimal(9, 6)
  bidPx          Decimal? @db.Decimal(18, 8)
  bidYield       Decimal? @db.Decimal(9, 6)
  /// ValidUntilTime(62)
  validUntil     DateTime
  receivedAt     DateTime @default(now())

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  @@unique([bankId, quoteId])
}

model Order {
  id              String   @id @default(uuid())
  tenantId        String
  /// ClOrdID(11)
  clOrdId         String   @unique
  /// OrderID(37), from the bank
  orderId         String?
  clientId        String
  bankId          String
  /// Quote (row id) this order accepts; one order per quote
  quoteId         String   @unique
  isin            String
  side            String
  ordType         String
  orderQty        Decimal  @db.Decimal(20, 2)
  /// OrdStatus(39), current-state projection of the executions
  ordStatus       String
  cumQty          Decimal  @default(0) @db.Decimal(20, 2)
  /// Buy: client cash reserved when the order was accepted
  reservedAmount  Decimal  @default(0) @db.Decimal(20, 2)
  /// Sell: client nominal reserved when the order was accepted
  reservedQty     Decimal  @default(0) @db.Decimal(20, 2)
  priceSnapshotId String   @unique
  text            String?
  /// Set when broker ops confirm the bank settled this order (ADR 0007)
  settledAt       DateTime?
  /// Bank statement / payment reference of the settlement
  settlementRef   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client        Client        @relation(fields: [clientId], references: [id])
  priceSnapshot PriceSnapshot @relation(fields: [priceSnapshotId], references: [id])
  executions    Execution[]

  @@index([tenantId, ordStatus])
}

/// Append-only history of ExecutionReports for an order.
model Execution {
  id                 String    @id @default(uuid())
  tenantId           String
  orderId            String
  bankId             String
  /// ExecID(17), idempotency key per bank
  execId             String
  execType           String
  ordStatus          String
  lastQty            Decimal?  @db.Decimal(20, 2)
  lastPx             Decimal?  @db.Decimal(18, 8)
  accruedInterestAmt Decimal?  @db.Decimal(20, 2)
  netMoney           Decimal?  @db.Decimal(20, 2)
  /// Buy: what the client was charged. Sell: net proceeds credited to the client.
  clientAmount       Decimal?  @db.Decimal(20, 2)
  /// Buy: owed to the bank. Sell: owed by the bank. Cleared at settlement.
  bankAmount         Decimal?  @db.Decimal(20, 2)
  settlDate          DateTime?
  transactTime       DateTime
  text               String?
  createdAt          DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@unique([bankId, execId])
}

/// Immutable record of what the client saw and agreed to (ADR 0008).
model PriceSnapshot {
  id              String   @id @default(uuid())
  tenantId        String
  quoteId         String
  /// BUY or SELL
  side            String
  pricingRule     Json
  bankCleanPx     Decimal  @db.Decimal(18, 8)
  bankYield       Decimal? @db.Decimal(9, 6)
  markupBps       Int
  clientCleanPx   Decimal  @db.Decimal(18, 8)
  clientYield     Decimal? @db.Decimal(9, 6)
  accruedInterest Decimal  @db.Decimal(20, 2)
  principal       Decimal  @db.Decimal(20, 2)
  commission      Decimal  @db.Decimal(20, 2)
  /// Buy: total the client pays. Sell: net proceeds to the client.
  netAmount       Decimal  @db.Decimal(20, 2)
  settlDate       DateTime
  disclosure      String
  createdAt       DateTime @default(now())

  order Order?
}

// ---------------------------------------------------------------------------
// FIX gateway bridge (platform-level) (ADR 0004, ADR 0010)
// ---------------------------------------------------------------------------

/// Messages from the API to banks. The FIX gateway polls PENDING rows.
model FixOutbox {
  id            BigInt    @id @default(autoincrement())
  bankId        String
  senderCompId  String
  targetCompId  String
  msgType       String
  /// FIX-shaped JSON (field names as in @agyal/shared-types)
  payload       Json
  status        String    @default("PENDING")
  error         String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
}

/// Messages from banks to the API, written by the FIX gateway.
model FixInbox {
  id           BigInt    @id @default(autoincrement())
  senderCompId String
  msgType      String
  payload      Json
  error        String?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
}

/// Raw FIX message store (every application message, in and out).
model FixMessage {
  id         BigInt   @id @default(autoincrement())
  sessionId  String
  direction  String
  msgType    String
  seqNum     Int
  raw        String
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Ledger (ADR 0007)
// ---------------------------------------------------------------------------

model LedgerAccount {
  id       String  @id @default(uuid())
  tenantId String
  /// null for broker-level accounts
  clientId String?
  /// LedgerAccountType in the ledger module
  type     String
  /// Currency code, or the ISIN for position (nominal) accounts
  unit     String
  /// Bank id for per-bank accounts (settlement payable)
  bankId   String?
  /// Unique key: tenant|client|type|unit|bank (avoids NULLs in a unique index)
  key      String  @unique

  postings Posting[]
}

model JournalEntry {
  id          String   @id @default(uuid())
  tenantId    String
  eventType   String
  reference   String
  createdById String?
  createdAt   DateTime @default(now())

  postings Posting[]

  @@unique([tenantId, eventType, reference])
}

model Posting {
  id             String  @id @default(uuid())
  tenantId       String
  journalEntryId String
  accountId      String
  /// Signed amount: debit positive, credit negative. Each entry sums to zero per unit.
  amount         Decimal @db.Decimal(24, 2)

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id])
  account      LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Audit (ADR 0001)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  actorId   String?
  action    String
  entity    String
  entityId  String
  data      Json?
  /// Request context: client IP, user agent, HTTP status, correlation id
  ip        String?
  userAgent String?
  outcome   Int?
  requestId String?
  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// Every insert/update/delete on business tables, written by a PostgreSQL
/// trigger (see the audit_trail migration). Secrets are redacted.
model DataChange {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  tableName String
  /// INSERT, UPDATE or DELETE
  op        String
  rowId     String?
  tenantId  String?
  actorId   String?
  requestId String?
  /// INSERT/DELETE: the row; UPDATE: { column: { from, to } } for changed columns
  changes   Json

  @@index([tableName, rowId])
  @@index([tenantId, at])
  @@index([actorId, at])
  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Client experience: indicative rates and news
// ---------------------------------------------------------------------------

/// Latest indicative bank yields per instrument (platform-wide), for browsing
/// rates before a live quote. Updated from bank quotes; seeded for the demo.
model IndicativeRate {
  isin       String   @id
  /// Bank offer yield (what a buyer gets before the broker's markup)
  offerYield Decimal? @db.Decimal(9, 6)
  /// Bank bid yield (what a seller gets before the broker's markup)
  bidYield   Decimal? @db.Decimal(9, 6)
  /// SEED, BANK_QUOTE or ADMIN
  source     String
  asOf       DateTime @default(now())
}

/// News shown on the client home page: platform-wide (tenantId null, posted
/// by Agyal) or for one broker's clients.
model Announcement {
  id          String   @id @default(uuid())
  tenantId    String?
  titleEn     String
  titleAr     String
  bodyEn      String
  bodyAr      String
  publishedAt DateTime @default(now())
  createdById String?

  @@index([tenantId, publishedAt])
}

/// Platform-wide settings set by Agyal admins (e.g. key "economics": default
/// custody, margins, commission, tax and deposit rates). Brokers override
/// fields in Tenant.config.economics.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// A concern Agyal raises about a broker's client (KYC/AML monitoring). The
/// broker, as the licensed party, responds and resolves it; Agyal cannot
/// approve or reject clients.
model ComplianceFlag {
  id             String    @id @default(uuid())
  tenantId       String
  clientId       String
  /// PEP_NOT_ESCALATED, SANCTIONS_HIT, ADVERSE_MEDIA, REVIEW_OVERDUE, DOCUMENTS, OTHER
  reason         String
  note           String
  raisedById     String
  raisedAt       DateTime  @default(now())
  /// OPEN or RESOLVED
  status         String    @default("OPEN")
  brokerResponse String?
  respondedById  String?
  resolvedAt     DateTime?

  @@index([tenantId, status])
  @@index([clientId])
}
